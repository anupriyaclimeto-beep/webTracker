{
  "portals": [
    {
      "name": "EPR PLASTIC",
      "url": "https://eprplastic.cpcb.gov.in/#/plastic/home",
      "auth": "manual",
      "crawl_interval_minutes": 60,
      "crawl": {
        "only_home": true,
        "capture_dropdowns": true
      }
    },
    {
      "name": "EPR EWASTE",
      "url": "https://eprewaste.cpcb.gov.in/#/",
      "auth": "none",
      "crawl_interval_minutes": 60,
      "crawl": {
        "only_home": true,
        "capture_dropdowns": true
      }
    },
    {
      "name": "EPR BATTERY",
      "url": "https://eprbattery.cpcb.gov.in/",
      "auth": "none",
      "crawl_interval_minutes": 60,
      "crawl": {
        "only_home": true,
        "capture_dropdowns": true
      }
    },
    {
      "name": "EPR TYRES",
      "url": "https://eprtyres.cpcb.gov.in/",
      "auth": "none",
      "crawl_interval_minutes": 60,
      "crawl": {
        "only_home": true,
        "capture_dropdowns": true
      }
    },
    {
      "name": "EPR USEDOIL",
      "url": "https://eprusedoil.cpcb.gov.in/",
      "auth": "none",
      "crawl_interval_minutes": 60,
      "crawl": {
        "only_home": true,
        "capture_dropdowns": true
      }
    },
    {
      "name": "EPR ELV",
      "url": "https://eprelv.cpcb.gov.in/",
      "auth": "none",
      "crawl_interval_minutes": 60,
      "crawl": { "only_home": true, "capture_dropdowns": true }
    },
    {
      "name": "CPCB NIC",
      "url": "https://cpcb.nic.in/index.php",
      "auth": "none",
      "crawl_interval_minutes": 60,
      "crawl": {
        "only_home": false,
        "full_page_stitch": true,
        "capture_menu_dropdowns": true,
        "menu_selector": ".sf-menu"
      }
    }
  ],
  "schedule": {
    "time": "07:00",
    "timezone": "Asia/Kolkata"
  },
  "diff": {
    "visual": true,
    "html": true,
    "json": true,
    "har": true,
    "pixel_threshold": 0.05
  },
  "storage": {
    "db": "changes.db",
    "archive_dir": "archive",
    "keep_days": 30
  },
  "browser": {
    "headless": true,
    "timeout_ms": 30000,
    "persistent": true,
    "user_data_dir": "browser_session",
    "viewport": {
      "width": 1280,
      "height": 800
    }
  }
}