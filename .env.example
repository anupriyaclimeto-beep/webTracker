SUPABASE_HOST=aws-0-eu-central-1.pooler.supabase.com
SUPABASE_PORT=6543
SUPABASE_DB=postgres
SUPABASE_USER=postgres.xxxxxxxxxx
SUPABASE_PASSWORD=yourpasswordhere

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Login credentials for legacy /api/login (optional when CLIMETO_AUTH_ENABLED=true)
LOGIN_USER=webtracker@test.com
LOGIN_PASS=123456

# Climeto JWT — must match JWT_SECRET on api.climeto.in
CLIMETO_JWT_SECRET=your-climeto-jwt-secret-here
CLIMETO_AUTH_ENABLED=true
