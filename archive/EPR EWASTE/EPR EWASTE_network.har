0:00.000+00:00\"}]"},"headersSize":758,"bodySize":1621,"redirectURL":"","_transferSize":2379},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":592.252,"receive":2.006},"serverIPAddress":"164.100.221.119","_serverPort":443,"_securityDetails":{"protocol":"TLS 1.2","subjectName":"*.cpcb.gov.in","issuer":"EM OV TLS CA - G2A-1","validFrom":1776941107,"validTo":1784717107}},{"pageref":"page@6ef9b62347211d9cb107c33a6400249c","startedDateTime":"2026-05-29T12:57:04.139Z","time":454.64200000000005,"request":{"method":"POST","url":"https://eprewaste.cpcb.gov.in/E-Waste/downTimeInfo","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"application/json, text/plain, */*"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Connection","value":"keep-alive"},{"name":"Content-Length","value":"2"},{"name":"Content-Type","value":"application/json"},{"name":"Host","value":"eprewaste.cpcb.gov.in"},{"name":"Origin","value":"https://eprewaste.cpcb.gov.in"},{"name":"Referer","value":"https://eprewaste.cpcb.gov.in/"},{"name":"Sec-Fetch-Dest","value":"empty"},{"name":"Sec-Fetch-Mode","value":"cors"},{"name":"Sec-Fetch-Site","value":"same-origin"},{"name":"User-Agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/124.0.0.0 Safari/537.36"},{"name":"X-Api-Key","value":"gST4k1Q7DXzzCu+5IF+kgjXaNBLAhcQt7D3wCcSdpXLiRv295+mRKjO4qlxn7eD7dYO6Wyt7kQ1iihf6IDiDvSBvasqxGPP7BalJ3l8kHRS68CUz91L23gqjOMaJMMSo"},{"name":"authorization","value":"Bearer null"},{"name":"geolocation","value":""},{"name":"role","value":""},{"name":"sec-ch-ua","value":"\"Chromium\";v=\"148\", \"HeadlessChrome\";v=\"148\", \"Not/A)Brand\";v=\"99\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Windows\""},{"name":"urole","value":""}],"queryString":[],"headersSize":818,"bodySize":2,"postData":{"mimeType":"application/json","text":"{}","params":[]}},"response":{"status":200,"statusText":"","httpVersion":"HTTP