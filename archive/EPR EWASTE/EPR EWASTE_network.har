Agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/124.0.0.0 Safari/537.36"},{"name":"X-Api-Key","value":"gST4k1Q7DXzzCu+5IF+kgjXaNBLAhcQt7D3wCcSdpXLiRv295+mRKjO4qlxn7eD7dYO6Wyt7kQ1iihf6IDiDveklEFuGFBpMuovu1xw/+giJ5maNUr1zwxIPKm+JplMu"},{"name":"authorization","value":"Bearer null"},{"name":"geolocation","value":""},{"name":"role","value":""},{"name":"sec-ch-ua","value":"\"Chromium\";v=\"148\", \"HeadlessChrome\";v=\"148\", \"Not/A)Brand\";v=\"99\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Windows\""},{"name":"urole","value":""}],"queryString":[],"headersSize":761,"bodySize":0},"response":{"status":200,"statusText":"","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Cache-Control","value":"no-cache, no-store, max-age=0, must-revalidate"},{"name":"Connection","value":"keep-alive"},{"name":"Content-Length","value":"2430"},{"name":"Content-Security-Policy","value":"script-src 'self'"},{"name":"Content-Security-Policy","value":"default-src 'self' http: https: data: blob: 'unsafe-inline'"},{"name":"Content-Type","value":"application/json"},{"name":"Date","value":"Fri, 29 May 2026 12:58:33 GMT"},{"name":"Expires","value":"0"},{"name":"Pragma","value":"no-cache"},{"name":"Referrer-Policy","value":"strict-origin"},{"name":"Server","value":"nginx"},{"name":"Strict-Transport-Security","value":"max-age=31536000; includeSubDomains; preload"},{"name":"Vary","value":"Origin"},{"name":"Vary","value":"Access-Control-Request-Method"},{"name":"Vary","value":"Access-Control-Request-Headers"},{"name":"X-Content-Type-Options","value":"nosniff"},{"name":"X-Content-Type-Options","value":"nosniff"},{"name":"X-Frame-Options","value":"DENY"},{"name":"X-Frame-Options","value":"DENY | SAMEORIGIN"},{"name":"X-XSS-Protection","value":"1; mode=block"},{"name":"X-XSS-Protection","value":"1; mode=block [2]"}],"content":{"size":2430,"mimeType":"application/json","compression":0,"text":"[{\"id\":3,\"description\":\"<div style=\\\"background-color:red; color:white; font-size:14px; border:solid 1px grey; padding:15px; border-radius:10px; text-align:justify; margin-top:20px;\\\">CPCB is conducting meeting through Video Conferencing to address the issues related EPR E-Waste portal. The entities can join the meeting through VC from Monday to Saturday between 4 PM to 5 PM. Following link to be used to join the meeting: <a target=\\\"_blank\\\" style=\\\"text-decoration:underline; color:blue;\\\" href=\\\"https://meet.google.com/rcp-trpu-ggx?pli=1\\\">https://meet.google.com/rcp-trpu-ggx?pli=1</a></div><div style=\\\"background-color:yellow; color:black; font-size:14px; border:solid 1px grey; padding:15px; border-radius:10px; margin-top:10px; text-align:justify;\\\"><b style=\\\"color:red;\\\">Kind Attention to Producer:</b><br>As per Rule 6(2) of the E-Waste (Management) Rules, 2022, all Producers are required to obtain and implement EPR targets through the portal as per Schedule III and IV. All Producers registered in FY 2023–24 shall submit their sales data for FY 2023–24 at the earliest to ensure timely fulfilment of EPR targets (as applicable). Non-compliance may attract action under the Rules.<br><br><b style=\\\"color:red;\\\">Kind Attention to Recycler:</b><br>All registered recyclers shall submit sales data and generate denominated EPR certificates for FY 2025–26 up to the date of filing of the Annual Return or 30.04.2026, whichever is earlier, for transfer to registered Producers. Such certificates shall be valid for two years as per the EW(M)Rules, 2022.</div><div style=\\\"background-color:#fe9c16; color:black; font-size:16px; border:solid 1px grey; padding:10px; border-radius:10px; margin-top:10px; position:absolute;\\\"><b>Lodge Complaint:</b><a target=\\\"_blank\\\" href=\\\"https://eprsupport.cpcb.gov.in/\\\"><button class=\\\"pri_btn fil-btn\\\" style=\\\"font-size:14px !important; font-weight:700 !important; line-height:18px !important; letter-spacing:1.1px !important;\\\">Create a Ticket</button></a><a target=\\\"_blank\\\" href=\\\"https://eprplastic.cpcb.gov.in/plastic/downloads/how_to_create_a_ticket.pdf\\\"><button class=\\\"pri_btn fil-btn\\\" style=\\\"font-size:14px !important; font-weight:700 !important; line-height:18px !important; letter-spacing:1.1px !important;\\\">How to create a Ticket</button></a></div>\",\"notificationType\":\"AnnouncementMessage\",\"isActive\":true,\"createdOn\":\"2024-04-16T18:30:00.000+00:00\"}]"},"headersSize":758,"bodySize":2431,"redirectURL":"","_transferSize":3189},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":72.085,"receive":1.986},"serverIPAddress":"164.100.221.119","_serverPort":443,"_securityDetails":{"protocol":"TLS 1.2","subjectName":"*.cpcb.gov.in","issuer":"EM OV TLS CA - G2A-1","validFrom":1776941107,"validTo":1784717107}}]}}